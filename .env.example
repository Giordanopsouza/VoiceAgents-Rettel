# SQLite file used by the calendar services. Use a persistent volume path in production.
DATABASE_PATH=data/calendar.sqlite

# Server-side live-call switch. false prevents new Retell web calls.
LIVE_DEMO_ENABLED=false

# Retell credentials stay on the server. Leave these empty until Retell is configured.
RETELL_API_KEY=
RETELL_AGENT_ID=

# Custom-function timeout the Failure Lab delay must exceed. Match the Retell
# dashboard value (milliseconds there; seconds here). Defaults: 2s timeout, 3s delay.
RETELL_FUNCTION_TIMEOUT_SECONDS=2
FAILURE_LAB_DELAY_SECONDS=3
